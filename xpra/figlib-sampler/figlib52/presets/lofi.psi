{
    "osc_waveforms": ["saw", "sine", "pluck", "bell", "organ", "fm_op", "pad_wash"],
    "osc_count": [1, 2],
    "unison_range": [1, 2],
    "unison_detune": [5, 15],
    "freq_range": [60, 600],
    "filter_prob": 0.8,
    "filter_types": ["lowpass"],
    "cutoff_range": [300, 3000],
    "fx_pool": ["bitcrush", "lofi", "vinyl", "tape", "studer",
                "tube", "warmth", "chorus", "ce1",
                "delay", "compressor", "body",
                "telephone", "radio", "fade"],
    "reverb_prob": 0.4,
    "delay_prob": 0.3,
    "envelope": {
        "attack": [0.005, 0.05],
        "hold": [0.0, 0.01],
        "decay": [0.1, 0.5],
        "sustain": [0.3, 0.7],
        "release": [0.05, 0.3]
    },
    "lfo": {
        "prob": 0.3,
        "rate": [0.5, 4.0],
        "shapes": ["sine", "triangle"],
        "targets": ["filter"],
        "amount": [0.1, 0.3]
    }
}

