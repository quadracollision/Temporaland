{
    "osc_waveforms": ["organ", "sine", "additive", "fm_op"],
    "osc_count": [1, 3],
    "unison_range": [1, 2],
    "unison_detune": [0, 5],
    "freq_range": [50, 800],
    "filter_prob": 0.3,
    "filter_types": ["lowpass"],
    "cutoff_range": [800, 6000],
    "fx_pool": ["chorus", "tube", "compressor", "warmth",
                "ce1", "dimension_d", "leslie", "tremolo",
                "body", "neve", "pultec", "fade",
                "spring", "harmonic_enhance"],
    "reverb_prob": 0.4,
    "delay_prob": 0.15,
    "envelope": {
        "attack": [0.005, 0.03],
        "hold": [0.0, 0.01],
        "decay": [0.1, 0.3],
        "sustain": [0.7, 1.0],
        "release": [0.05, 0.2]
    },
    "lfo": {
        "prob": 0.5,
        "rate": [4.0, 8.0],
        "shapes": ["sine"],
        "targets": ["pitch"],
        "amount": [0.01, 0.04]
    }
}

