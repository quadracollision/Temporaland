{
    "osc_waveforms": ["chip", "square", "pulse", "triangle", "sine"],
    "osc_count": [1, 2],
    "unison_range": [1, 1],
    "unison_detune": [0, 0],
    "freq_range": [100, 2000],
    "filter_prob": 0.3,
    "filter_types": ["lowpass"],
    "cutoff_range": [1000, 8000],
    "fx_pool": ["bitcrush", "distortion", "compressor", "limiter",
                "lofi", "gate", "delay", "chorus",
                "arp_ring", "octaver", "fade"],
    "reverb_prob": 0.15,
    "delay_prob": 0.3,
    "envelope": {
        "attack": [0.001, 0.005],
        "hold": [0.0, 0.005],
        "decay": [0.05, 0.2],
        "sustain": [0.3, 0.8],
        "release": [0.02, 0.1]
    },
    "lfo": {
        "prob": 0.3,
        "rate": [4.0, 20.0],
        "shapes": ["square", "sine"],
        "targets": ["pitch"],
        "amount": [0.05, 0.2]
    }
}

