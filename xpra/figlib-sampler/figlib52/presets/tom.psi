{
    "osc_waveforms": ["tom", "kick_808", "kick", "sine"],
    "osc_count": [1, 1],
    "unison_range": [1, 1],
    "unison_detune": [0, 0],
    "freq_range": [60, 200],
    "filter_prob": 0.5,
    "filter_types": ["lowpass", "bandpass"],
    "cutoff_range": [100, 2000],
    "fx_pool": ["distortion", "tube", "compressor", "transient",
                "body", "tape", "fade", "limiter", "warmth"],
    "reverb_prob": 0.4,
    "delay_prob": 0.05,
    "envelope": {
        "attack": [0.0003, 0.005],
        "hold": [0.0, 0.005],
        "decay": [0.1, 0.4],
        "sustain": [0.0, 0.15],
        "release": [0.03, 0.15]
    },
    "lfo": {
        "prob": 0.05,
        "rate": [2.0, 8.0],
        "shapes": ["sine"],
        "targets": ["pitch"],
        "amount": [0.03, 0.1]
    }
}

