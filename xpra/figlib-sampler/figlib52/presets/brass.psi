{
    "osc_waveforms": ["brass", "saw", "square", "pulse", "supersaw"],
    "osc_count": [1, 2],
    "unison_range": [1, 3],
    "unison_detune": [5, 15],
    "freq_range": [80, 800],
    "filter_prob": 0.7,
    "filter_types": ["lowpass"],
    "cutoff_range": [400, 4000],
    "fx_pool": ["compressor", "tube", "distortion", "limiter",
                "neve", "ssl", "1176", "warmth", "body",
                "exciter", "transient", "fade"],
    "reverb_prob": 0.3,
    "delay_prob": 0.1,
    "envelope": {
        "attack": [0.01, 0.08],
        "hold": [0.0, 0.02],
        "decay": [0.1, 0.4],
        "sustain": [0.4, 0.8],
        "release": [0.05, 0.2]
    },
    "lfo": {
        "prob": 0.3,
        "rate": [3.0, 8.0],
        "shapes": ["sine", "triangle"],
        "targets": ["pitch"],
        "amount": [0.02, 0.06]
    }
}

