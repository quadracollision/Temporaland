{
    "osc_waveforms": ["vocal", "breath", "pad_wash", "additive", "fm_op"],
    "osc_count": [1, 2],
    "unison_range": [1, 3],
    "unison_detune": [3, 15],
    "freq_range": [100, 800],
    "filter_prob": 0.7,
    "filter_types": ["lowpass", "bandpass"],
    "cutoff_range": [300, 4000],
    "fx_pool": ["formant", "chorus", "ensemble", "delay",
                "tube", "warmth", "ce1", "dimension_d",
                "stereo_widen", "shimmer", "compressor",
                "neve", "pultec", "fade"],
    "reverb_prob": 0.6,
    "delay_prob": 0.2,
    "envelope": {
        "attack": [0.05, 0.4],
        "hold": [0.0, 0.02],
        "decay": [0.2, 0.8],
        "sustain": [0.5, 0.9],
        "release": [0.1, 0.5]
    },
    "lfo": {
        "prob": 0.4,
        "rate": [2.0, 6.0],
        "shapes": ["sine"],
        "targets": ["filter", "pitch"],
        "amount": [0.05, 0.15]
    }
}

