{
    "osc_waveforms": ["pad_wash", "wavetable", "additive", "strings", "glass", "bell"],
    "osc_count": [1, 3],
    "unison_range": [2, 4],
    "unison_detune": [5, 25],
    "freq_range": [100, 1000],
    "filter_prob": 0.6,
    "filter_types": ["lowpass"],
    "cutoff_range": [500, 6000],
    "fx_pool": ["chorus", "shimmer", "crystal", "delay",
                "stereo_widen", "width_enhance", "dimension",
                "dimension_d", "ce1", "tube", "warmth",
                "granular", "spectral_freeze", "spatial",
                "lexicon", "emt_plate", "fade"],
    "reverb_prob": 0.9,
    "delay_prob": 0.5,
    "envelope": {
        "attack": [0.2, 1.5],
        "hold": [0.0, 0.05],
        "decay": [0.5, 2.0],
        "sustain": [0.5, 0.9],
        "release": [0.5, 2.0]
    },
    "lfo": {
        "prob": 0.5,
        "rate": [0.05, 0.3],
        "shapes": ["sine", "triangle"],
        "targets": ["filter"],
        "amount": [0.1, 0.3]
    }
}

