{
    "osc_waveforms": ["strings", "saw", "supersaw", "pad_wash"],
    "osc_count": [2, 3],
    "unison_range": [2, 4],
    "unison_detune": [5, 20],
    "freq_range": [80, 1200],
    "filter_prob": 0.7,
    "filter_types": ["lowpass"],
    "cutoff_range": [500, 5000],
    "fx_pool": ["chorus", "ensemble", "compressor", "tube",
                "ce1", "dimension_d", "warmth", "body",
                "stereo_widen", "width_enhance", "fade",
                "neve", "ssl", "pultec"],
    "reverb_prob": 0.6,
    "delay_prob": 0.1,
    "envelope": {
        "attack": [0.05, 0.3],
        "hold": [0.0, 0.02],
        "decay": [0.2, 0.6],
        "sustain": [0.5, 0.9],
        "release": [0.1, 0.5]
    },
    "lfo": {
        "prob": 0.4,
        "rate": [3.0, 7.0],
        "shapes": ["sine", "triangle"],
        "targets": ["pitch"],
        "amount": [0.01, 0.04]
    }
}

