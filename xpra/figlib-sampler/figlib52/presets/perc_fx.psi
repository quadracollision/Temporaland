{
    "osc_waveforms": ["cowbell_808", "cowbell", "shaker", "woodblock",
                      "zap", "scratch", "impact", "click"],
    "osc_count": [1, 2],
    "unison_range": [1, 1],
    "unison_detune": [0, 0],
    "freq_range": [100, 2000],
    "filter_prob": 0.6,
    "filter_types": ["lowpass", "highpass", "bandpass"],
    "cutoff_range": [200, 8000],
    "fx_pool": ["distortion", "bitcrush", "compressor", "limiter",
                "transient", "gate", "resonator", "reverse", "glitch",
                "tape_stop", "fade", "lofi", "tube",
                "dbx160", "ssl", "1176", "ams_reverb"],
    "reverb_prob": 0.3,
    "delay_prob": 0.1,
    "envelope": {
        "attack": [0.0003, 0.005],
        "hold": [0.0, 0.005],
        "decay": [0.05, 0.3],
        "sustain": [0.0, 0.2],
        "release": [0.02, 0.15]
    },
    "lfo": {
        "prob": 0.1,
        "rate": [5.0, 20.0],
        "shapes": ["sine", "exp_fall"],
        "targets": ["filter"],
        "amount": [0.1, 0.3]
    }
}

