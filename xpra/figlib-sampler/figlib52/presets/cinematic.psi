{
    "osc_waveforms": ["impact", "drone_dark", "noise_brown", "noise_white",
                      "pad_wash", "supersaw", "strings"],
    "osc_count": [1, 3],
    "unison_range": [2, 5],
    "unison_detune": [10, 40],
    "freq_range": [25, 200],
    "filter_prob": 0.7,
    "filter_types": ["lowpass", "bandpass"],
    "cutoff_range": [40, 3000],
    "fx_pool": ["distortion", "tube", "wavefolder", "compressor", "limiter",
                "maximizer", "body", "warmth", "stereo_widen",
                "reverse", "granular", "spectral_freeze",
                "transient", "1176", "ssl", "neve",
                "parallel_comp", "multiband", "fade"],
    "reverb_prob": 0.8,
    "delay_prob": 0.3,
    "envelope": {
        "attack": [0.01, 1.0],
        "hold": [0.0, 0.1],
        "decay": [0.5, 3.0],
        "sustain": [0.3, 0.8],
        "release": [0.3, 2.0]
    },
    "lfo": {
        "prob": 0.4,
        "rate": [0.05, 0.5],
        "shapes": ["sine", "exp_fall"],
        "targets": ["filter"],
        "amount": [0.2, 0.6]
    }
}

