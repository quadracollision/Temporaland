{
    "osc_waveforms": ["noise_white", "noise_pink", "fm_op", "granular", "bitcrush", "sine", "triangle"],
    "osc_count": [1, 3],
    "unison_range": [1, 2],
    "unison_detune": [0.5, 1.0],
    "freq_range": [50, 5000],
    "envelope": {
        "attack": [0.0, 0.05],
        "hold": [0.0, 0.0],
        "decay": [0.01, 0.2],
        "sustain": [0.0, 0.0],
        "release": [0.0, 0.1]
    },
    "lfo": {
        "prob": 1.0,
        "rate": [10.0, 50.0],
        "shapes": ["sample_hold", "noise"],
        "targets": ["osc:pitch", "filter:cutoff", "amp:gain", "pan"],
        "amount": [0.2, 0.8]
    },
    "filter_prob": 1.0,
    "filter_types": ["lowpass", "highpass", "bandpass", "notch", "comb"],
    "cutoff_range": [100, 8000],
    "fx_pool": ["bitcrush", "stutter", "repeater", "granulizer", "ring_mod", "freq_shift", "delay", "distortion"],
    "fx_prob": 1.0,
    "bitcrush_prob": 0.5,
    "stutter_prob": 0.4,
    "delay_prob": 0.5,
    "reverb_prob": 0.4
}

