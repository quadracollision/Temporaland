{
    "osc_waveforms": ["saw", "square", "pulse", "morph", "supersaw", "sync", "pwm_sweep", "brass", "fm_op", "wavetable", "harsh"],
    "osc_count": [1, 2],
    "unison_range": [1, 5],
    "unison_detune": [5, 30],
    "freq_range": [200, 2000],
    "filter_prob": 0.6,
    "filter_types": ["lowpass", "bandpass", "peaking"],
    "cutoff_range": [800, 10000],
    "fx_pool": ["distortion", "chorus", "flanger", "exciter", "vibrato",
                "wavefolder", "pitch_shift", "harmonizer", "octaver",
                "crystal", "dimension",
                "moog", "303", "prophet", "sem", "marshall", "space_echo",
                "vox", "h3000", "buchla_lpg",
                "harmonic_enhance", "parallel_comp", "warmth", "body",
                "obxa", "wasp", "1176"],
    "reverb_prob": 0.4,
    "delay_prob": 0.4,
    "envelope": {
        "attack": [0.005, 0.05],
        "hold": [0.0, 0.02],
        "decay": [0.1, 0.5],
        "sustain": [0.5, 0.8],
        "release": [0.1, 0.5]
    },
    "lfo": {
        "prob": 0.4,
        "rate": [2.0, 8.0],
        "shapes": ["sine", "triangle", "square"],
        "targets": ["pitch", "filter"],
        "amount": [0.1, 0.3]
    }
}

