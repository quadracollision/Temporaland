{
    "osc_waveforms": ["kick_808", "kick_909", "impact", "explosion", "noise_brown", "noise_pink", "sub_drop"],
    "osc_count": [1, 2],
    "unison_range": [1, 1],
    "unison_detune": [0.0, 0.0],
    "freq_range": [30, 100],
    "envelope": {
        "attack": [0.0, 0.1],
        "hold": [0.0, 0.0],
        "decay": [0.5, 2.0],
        "sustain": [0.0, 0.0],
        "release": [2.0, 5.0]
    },
    "filter_prob": 0.5,
    "filter_types": ["lowpass"],
    "cutoff_range": [100, 500],
    "fx_pool": ["reverb", "delay", "compressor", "limiter", "sub_bass", "lowpass", "stereo_widen"],
    "fx_prob": 1.0,
    "delay_prob": 0.0,
    "reverb_prob": 1.0,
    "reverb_size": [0.8, 1.0],
    "reverb_mix": [0.3, 0.6],
    "lfo": {
        "prob": 0.2,
        "rate": [0.5, 2.0],
        "shapes": ["sine"],
        "targets": ["filter:cutoff"],
        "amount": [0.1, 0.3]
    }
}

