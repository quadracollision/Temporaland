[Unit]
Description=Two-player Audacity browser session
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=audacity-studio
Group=audacity-studio
SupplementaryGroups=audio
Environment=HOME=/srv/audacity-studio
Environment=XDG_RUNTIME_DIR=/run/audacity-studio
RuntimeDirectory=audacity-studio
RuntimeDirectoryMode=0700
WorkingDirectory=/srv/audacity-studio/projects
ExecStart=/usr/local/libexec/audacity-studio-launch
Restart=always
RestartSec=5
TimeoutStopSec=30
Nice=5
CPUQuota=85%
MemoryHigh=600M
MemoryMax=700M
OOMScoreAdjust=500
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/audacity-studio

[Install]
WantedBy=multi-user.target
