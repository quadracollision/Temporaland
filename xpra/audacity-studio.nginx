location = /temporaman {
    return 301 /temporaman/;
}

location = /temporaman/ {
    add_header Cache-Control "no-store" always;
    return 302 /temporaman/login.html;
}

location = /temporaman/login.html {
    alias /var/www/temporaman/login.html;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
}

location = /temporaman/audio-input.js {
    alias /var/www/temporaman/audio-input.js;
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
}

location = /temporaman/collab.js {
    alias /var/www/temporaman/collab.js;
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
}

location = /temporaman/api/login {
    proxy_pass http://127.0.0.1:14501/login;
    proxy_set_header X-Real-IP $remote_addr;
    client_max_body_size 8k;
}

location = /temporaman/_auth {
    internal;
    client_max_body_size 10m;
    proxy_pass http://127.0.0.1:14501/auth;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Cookie $http_cookie;
}

location = /temporaman/studio.html {
    return 302 /temporaman/shrine.html;
}

location = /temporaman/shrine.html {
    auth_request /temporaman/_auth;
    error_page 401 =302 /temporaman/login.html;
    alias /var/www/temporaman/shrine.html;
    add_header Cache-Control "no-store" always;
}

location = /temporaman/upload {
    auth_request /temporaman/_auth;
    error_page 401 =302 /temporaman/login.html;
    proxy_pass http://127.0.0.1:14501/upload;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header X-Real-IP $remote_addr;
    client_max_body_size 10m;
    proxy_read_timeout 3600;
    proxy_send_timeout 3600;
}

location = /temporaman/files {
    auth_request /temporaman/_auth;
    error_page 401 =302 /temporaman/login.html;
    proxy_pass http://127.0.0.1:14502/files;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_buffering off;
}

location = /temporaman/download {
    auth_request /temporaman/_auth;
    error_page 401 =302 /temporaman/login.html;
    proxy_pass http://127.0.0.1:14502/download$is_args$args;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_buffering off;
    proxy_read_timeout 3600;
    proxy_send_timeout 3600;
}

location = /temporaman/launch/downloader {
    auth_request /temporaman/_auth;
    error_page 401 =302 /temporaman/login.html;
    proxy_pass http://127.0.0.1:14503/downloader;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header X-Real-IP $remote_addr;
    client_max_body_size 1k;
}

location = /temporaman/collab {
    auth_request /temporaman/_auth;
    error_page 401 =302 /temporaman/login.html;
    proxy_pass http://127.0.0.1:14502/collab;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Cookie $http_cookie;
    proxy_read_timeout 86400;
    proxy_send_timeout 86400;
    proxy_buffering off;
}

location = /temporaman/audio-input {
    auth_request /temporaman/_auth;
    proxy_pass http://127.0.0.1:14502/audio-input;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_buffering off;
    proxy_read_timeout 86400;
}

location = /temporaman/audio {
    auth_request /temporaman/_auth;
    error_page 401 =302 /temporaman/login.html;
    proxy_pass http://127.0.0.1:14501/audio;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Cookie $http_cookie;
    proxy_read_timeout 86400;
    proxy_send_timeout 86400;
    proxy_buffering off;
}

location = /temporaman/websockify {
    auth_request /temporaman/_auth;
    proxy_pass http://127.0.0.1:14500;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 86400;
    proxy_send_timeout 86400;
    proxy_buffering off;
}

location ^~ /temporaman/ {
    auth_request /temporaman/_auth;
    error_page 401 =302 /temporaman/login.html;
    alias /usr/share/novnc/;
    index vnc.html;
    add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    add_header X-Content-Type-Options "nosniff" always;
}
