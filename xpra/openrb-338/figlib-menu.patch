+#[test]
+fn sample_oscillator_retriggers_and_changes_the_voice() {
+    let t = Tables::new();
+    let ctx = BlockContext {
+        tables: &t,
+        meter_index: 0,
+        tempo: 120_000,
+        tick: 0,
+        stack_word: None,
+    };
+    let mut stock = Tb303::new();
+    stock.note_on(NOTE);
+    let mut stock_bus = [0.0; BLOCK];
+    stock.process(&mut stock_bus, &ctx);
+
+    let mut sampled = Tb303::new();
+    let oscillator = Arc::new(Sample::from_audio(&[
+        32767, 24000, 8000, -8000, -24000, -32768, -12000, 12000,
+    ]));
+    sampled.set_oscillator_sample(Some(oscillator), &mut Retired::default());
+    sampled.sample_pos = 5.0;
+    sampled.note_on(NOTE);
+    assert_eq!(sampled.sample_pos, 0.0);
+    let mut sampled_bus = [0.0; BLOCK];
+    sampled.process(&mut sampled_bus, &ctx);
+    assert_ne!(sampled_bus, stock_bus);
+    assert!(sampled_bus.iter().any(|value| value.abs() > 1e-6));
+
+    sampled.sample_pos = 5.0;
+    sampled.slide = true;
+    sampled.note_on(NOTE);
+    assert_eq!(sampled.sample_pos, 5.0);
+}
